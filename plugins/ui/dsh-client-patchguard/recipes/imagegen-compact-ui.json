    },
    {
      "tag": "展开态：只换底色，不再把图标提亮到 label-primary（与相邻两个按钮同色）",
      "old": ".dsh-ig-pill-button-open{background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.14));color:var(--dsw-alias-label-primary,#111827)}",
      "new": ".dsh-ig-pill-button-open{background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.14));color:var(--dsw-alias-label-secondary,#4b5563)}"
