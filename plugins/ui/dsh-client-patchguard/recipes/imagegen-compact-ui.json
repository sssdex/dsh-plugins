  "patchedSha256": "196769E13297597C8980FC7E0B103ED0C017BE96F850A53975FA255961122ACC",
  "pristineMarkers": [
    ".dsh-ig-pill-button{display:inline-flex;align-items:center;gap:5px;height:28px",
