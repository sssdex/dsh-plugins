{
  "name": "dsh-file-launcher",
  "version": "0.2.1",
  "description": "DeepSeek Harness 文件启动器：把聊天里的文件变成「点一下就运行 / 打开 / 定位」的链接。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "launcher"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
