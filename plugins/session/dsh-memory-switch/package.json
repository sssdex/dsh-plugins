{
  "name": "dsh-memory-switch",
  "version": "0.1.0",
  "description": "记忆上下文注入的会话级开关：模型菜单里一个开关，决定本会话要不要让记忆系统往上下文里注入摘要 / 召回 / 规则。默认关闭。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/host-probe.mjs test/contract-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "memory",
    "context",
    "switch"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
