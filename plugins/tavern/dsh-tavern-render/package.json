{
  "name": "dsh-tavern-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把酒馆预设的结构化回话（正文/状态/动态/聊天/选项）渲染成有层级、可一眼读懂的界面。",
  "keywords": ["dsh", "dsh-plugin", "sillytavern", "tavern", "roleplay", "render"],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/parse.js",
    "lib/render.js",
    "lib/styles.js",
    "lib/client.bundle.tpl.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "scripts/",
    "test/",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
